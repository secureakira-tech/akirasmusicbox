---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import PrimaryEmbed from '../../components/PrimaryEmbed.astro';
import ReferenceEmbed from '../../components/ReferenceEmbed.astro';
import Note from '../../components/Note.astro';
import ArtistSupport from '../../components/ArtistSupport.astro';
import ClosingRitual from '../../components/ClosingRitual.astro';
import NewsletterSubscribe from '../../components/NewsletterSubscribe.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = {
  post: Awaited<ReturnType<typeof getCollection<'posts'>>>[number];
};

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, genre, era, instrument, mood, postType, hifiSidebar } = post.data;
---

<PostLayout
  {title}
  {description}
  {pubDate}
  {genre}
  {era}
  {instrument}
  {mood}
  {postType}
  {hifiSidebar}
>
  <div class="prose">
    <Content components={{ PrimaryEmbed, ReferenceEmbed, Note, ArtistSupport, ClosingRitual, NewsletterSubscribe }} />
  </div>
</PostLayout>
